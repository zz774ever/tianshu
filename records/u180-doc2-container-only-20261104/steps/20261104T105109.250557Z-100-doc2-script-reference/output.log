"""Install the same FlagGems-vllm release in every platform's CI interpreter."""

import json
import os
import subprocess
import sys
from importlib.metadata import PackageNotFoundError, distribution, version

RELEASE = "v0.2.0"
COMMIT = "b5c2c2249319277ccda4d41aa0f65164bd9b2a19"
REPOSITORY = "https://github.com/flagos-ai/FlagGems-vllm.git"
RUNTIME_PACKAGES = ("torch", "flagtree", "triton", "flag-gems", "vllm", "numpy")
PACKAGE_DEPENDENCIES = ("packaging", "pybind11", "PyYAML", "sqlalchemy")


def package_version(name):
    try:
        return version(name)
    except PackageNotFoundError:
        return None


def release_is_installed():
    try:
        text = distribution("flaggems-vllm").read_text("direct_url.json")
        source = json.loads(text or "{}")
    except (PackageNotFoundError, ValueError):
        return False
    return (
        source.get("url", "").removesuffix(".git") == REPOSITORY.removesuffix(".git")
        and source.get("vcs_info", {}).get("commit_id") == COMMIT
    )


def pip_install(*args):
    env = dict(os.environ, PIP_BREAK_SYSTEM_PACKAGES="1")
    subprocess.run([sys.executable, "-m", "pip", "install", *args], env=env, check=True)


def main():
    before = {name: package_version(name) for name in RUNTIME_PACKAGES}
    missing = [name for name in PACKAGE_DEPENDENCIES if package_version(name) is None]
    if missing:
        pip_install(*missing)
    if not release_is_installed():
        # Metadata still says 0.1.0; force replacement of another 0.1.0 source.
        # Reuse the build tools already used by this platform's plugin setup.
        pip_install(
            "--no-deps",
            "--no-build-isolation",
            "--force-reinstall",
            f"flaggems-vllm @ git+{REPOSITORY}@{COMMIT}",
        )
    if not release_is_installed():
        raise RuntimeError(f"FlagGems-vllm must come from {RELEASE} commit {COMMIT}")
    after = {name: package_version(name) for name in RUNTIME_PACKAGES}
    if after != before:
        raise RuntimeError(f"CI runtime dependencies changed: {before} -> {after}")
    print(
        f"FlagGems-vllm: {RELEASE}, commit {COMMIT}, "
        f"package metadata {package_version('flaggems-vllm')}"
    )


if __name__ == "__main__":
    main()
import datetime
import hashlib
import json
from pathlib import Path
import urllib.request


root = Path('/workspace/tianshu-delivery')
published = json.loads(Path('/workspace/validation/tutorial-publish-result.json').read_text())
prefix = 'https://api.github.com/repos/zz774ever/tianshu'


def read(path):
    request = urllib.request.Request(prefix + path, headers={'User-Agent': 'tianshu-publication-verification'})
    with urllib.request.urlopen(request, timeout=45) as response:
        return json.load(response)


reference = read('/git/ref/heads/main')
assert reference['object']['sha'] == published['commit'], reference
tree = read('/git/trees/' + published['commit'] + '?recursive=1')
assert not tree.get('truncated'), 'Truncated repository tree'
entries = {entry['path']: entry for entry in tree['tree']}
for name in published['files']:
    data = (root / name).read_bytes()
    expected = hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\x00' + data).hexdigest()
    assert entries[name]['sha'] == expected, name
result = {'verified_utc': datetime.datetime.now(datetime.UTC).isoformat(),
          'commit': published['commit'], 'branch': 'main', 'files_verified': len(published['files']),
          'all_blob_hashes_match': True,
          'tutorial': 'https://github.com/zz774ever/tianshu/blob/' + published['commit'] + '/docs/iluvatar-vllm032-local-reproduction.md'}
Path('/workspace/validation/tutorial-publication-verification.json').write_text(
    json.dumps(result, ensure_ascii=False, indent=2) + '\n')
print(json.dumps(result, ensure_ascii=False, indent=2))
