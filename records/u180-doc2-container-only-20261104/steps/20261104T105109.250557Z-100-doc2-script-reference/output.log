import os
from pathlib import Path
import sys


def main():
    if sys.prefix == sys.base_prefix:
        raise SystemExit('Activate the isolated venv before preparing its CLI')
    import pytest

    target = Path(sys.prefix) / 'bin/pytest'
    content = (
        f'#!{sys.executable}\n'
        'from pytest import console_main\n'
        '\n'
        'if __name__ == "__main__":\n'
        '    raise SystemExit(console_main())\n'
    )
    if not target.exists() or target.read_text() != content:
        target.write_text(content)
        target.chmod(target.stat().st_mode | 0o111)
    print(f'pytest module: {pytest.__file__}')
    print(f'pytest entry: {target}')
    print(f'interpreter: {sys.executable}')
    assert os.access(target, os.X_OK)


if __name__ == '__main__':
    main()
import os
from datetime import timedelta


def main():
    import torch
    from torch import distributed
    from vllm_fl.distributed.device_communicators.flagcx import PyFlagcxCommunicator

    local_rank = int(os.environ["LOCAL_RANK"])
    torch.cuda.set_device(local_rank)
    distributed.init_process_group("gloo", timeout=timedelta(seconds=120))
    communicator = None
    try:
        world_size = distributed.get_world_size()
        assert world_size >= 2, "Use torchrun with at least two processes"
        communicator = PyFlagcxCommunicator(distributed.group.WORLD, torch.device("cuda", local_rank))
        assert communicator.available and not communicator.disabled, getattr(communicator, "init_error", None)
        tensor = torch.full((1024,), float(distributed.get_rank() + 1), device=f"cuda:{local_rank}")
        result = communicator.all_reduce(tensor)
        torch.cuda.synchronize()
        expected = world_size * (world_size + 1) / 2
        assert torch.equal(result, torch.full_like(result, expected)), result[:4]
        print(f"FLAGCX_PASS rank={distributed.get_rank()} world_size={world_size} values={result[:4].tolist()}", flush=True)
        distributed.barrier()
    finally:
        if communicator is not None:
            communicator.destroy()
        distributed.destroy_process_group()


if __name__ == "__main__":
    main()
import argparse
import hashlib
from importlib import metadata
import json
import os
from pathlib import Path
import sys


def main():
    parser = argparse.ArgumentParser(description="Qwen3-4B BF16 text smoke on the adapted runtime")
    parser.add_argument("--model", required=True)
    parser.add_argument("--tp", type=int, choices=(1, 2, 4), default=1)
    parser.add_argument("--graph", action="store_true")
    parser.add_argument("--output", required=True)
    args = parser.parse_args()
    output = Path(args.output)
    if output.exists():
        parser.error("Output exists; use a new path to preserve previous results")
    if not (Path(args.model) / "config.json").is_file():
        parser.error("Model directory must contain config.json")

    import vllm
    from vllm import LLM, SamplingParams

    assert vllm.__version__.split("+")[0] == "0.32.0", vllm.__version__
    options = {}
    if args.graph:
        options["compilation_config"] = {
            "mode": 0, "cudagraph_mode": "FULL", "custom_ops": ["all"],
            "ir_enable_torch_wrap": False,
        }
    model = LLM(
        model=args.model, tensor_parallel_size=args.tp,
        dtype="bfloat16", enforce_eager=not args.graph,
        max_model_len=512, max_num_seqs=2, gpu_memory_utilization=0.65,
        max_num_batched_tokens=512, seed=0,
        **options,
    )
    prompts = ["The capital of France is", "The speed of light in vacuum is approximately"]
    generated = model.generate(prompts, SamplingParams(temperature=0, max_tokens=16))
    assert len(generated) == len(prompts), "Missing generation results"
    records = []
    for result in generated:
        completion = result.outputs[0]
        assert completion.token_ids and completion.text.strip(), "Empty generation"
        records.append({"prompt": result.prompt, "text": completion.text,
                        "token_ids": list(completion.token_ids)})
    output.parent.mkdir(parents=True, exist_ok=True)
    report = {"status": "PASS", "vllm_version": vllm.__version__,
              "vllm_path": vllm.__file__, "model": args.model,
              "tp": args.tp, "graph": args.graph, "outputs": records,
              "python": sys.executable,
              "devices": os.environ.get('CUDA_VISIBLE_DEVICES'),
              "versions": {name: metadata.version(name) for name in (
                  'torch', 'flagtree', 'flag-gems', 'transformers', 'tokenizers', 'numpy')},
              "model_config_sha256": hashlib.sha256(
                  (Path(args.model) / 'config.json').read_bytes()).hexdigest(),
              "scope": "Nonempty generation only; not semantic correctness or NVIDIA alignment"}
    with output.open("x") as handle:
        json.dump(report, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
    print(json.dumps(report, ensure_ascii=False, indent=2), flush=True)


if __name__ == "__main__":
    main()
